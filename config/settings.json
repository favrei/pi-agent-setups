{
  "theme": "dark",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-6.1-sol:xhigh",
    "openai-codex/gpt-6-astra:xhigh",
    "anthropic/claude-opus-5-5:high",
    "meta/muse-spark-1.3-contributor:xhigh"
  ],
  "packages": [
    "npm:pi-meta-oauth",
    "npm:@narumitw/pi-goal",
    "npm:pi-subagents",
    "npm:pi-background-tasks",
    "npm:pi-claude-auth",
    "npm:pi-web-access",
    "npm:pi-codex-search",
    "npm:pi-mcp-adapter",
    "git:github.com/favrei/pi-ssh"
  ],
  "subagents": {
    "defaultModel": "openai-codex/gpt-6.1-sol",
    "defaultThinking": "low",
    "agentOverrides": {
      "worker": {
        "disabled": true
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      }
    }
  },
  "compactionModel": {
    "model": "meta/muse-spark-1.3-contributor",
    "thinkingLevel": "minimal",
    "fallbacks": [
      {
        "model": "deepseek/deepseek-flash",
        "thinkingLevel": "off"
      }
    ],
    "timeoutMs": 90000,
    "reasons": [
      "manual",
      "threshold",
      "overflow"
    ]
  }
}
