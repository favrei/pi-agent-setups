{
  "name": "pi-compaction-model-fallback",
  "version": "0.1.0",
  "description": "Ordered, bounded dedicated compaction models with Pi-native active-model fallback.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "compaction",
    "llm"
  ],
